+      <main className="app-main">
+        {tab === "dashboard" && <Dashboard />}
+        {tab === "models" && <Models />}
+        {tab === "payments" && <Payments />}
+      </main>
+
+      <nav className="tabbar" aria-label="التنقل">
+        {TABS.map(({ id, label }) => (
+          <button
+            key={id}
+            className={tab === id ? "tab active" : "tab"}
+            aria-current={tab === id ? "page" : undefined}
+            onClick={() => setTab(id)}
+          >
+            {label}
+          </button>
+        ))}
+      </nav>
     </div>
   );
 }
