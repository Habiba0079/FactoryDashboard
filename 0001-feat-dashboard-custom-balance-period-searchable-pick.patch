+.filter-label { display: block; font-weight: 700; font-size: 0.9rem; margin-bottom: 4px; }
+.cards { margin-bottom: 14px; }
+
+/* Weekly chart */
+.chart-scroll { overflow-x: auto; }
+.chart-scroll svg { display: block; margin: 0 auto; }
+.chart-axis { stroke: var(--border); stroke-width: 1; }
+.bar-pos { fill: #1d4ed8; }
+.bar-neg { fill: var(--danger); }
+.bar-zero { fill: var(--muted); }
+.chart-value { font-size: 11px; fill: var(--text); }
+.chart-label { font-size: 11px; fill: var(--muted); }
+.chart-note { color: var(--muted); font-size: 0.85rem; margin: 10px 0 0; }
+.dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; }
+.dot-pos { background: #1d4ed8; }
+.dot-neg { background: var(--danger); }
