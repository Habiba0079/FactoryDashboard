+function buildPayment(data) {
+  const amount = Number(data.amount);
+  const date = String(data.date || "").slice(0, 10);
+  const notes = String(data.notes || "").trim();
+
+  if (!date || !(amount > 0)) {
+    return null;
+  }
+
+  return { date, amount, notes };
